#: src/reference/syntax/r-strings.md:1
msgid "R-strings"
msgstr ""

#: src/reference/syntax/r-strings.md:3
msgid "R-strings handle escape characters without special treatment:"
msgstr ""

#: src/reference/syntax/r-strings.md:5
msgid ""
"```prql\n"
"from artists\n"
"derive normal_string =  \"\\\\\\t\"   #  two characters - \\ and tab (\\t)\n"
"derive raw_string    = r\"\\\\\\t\"   # four characters - \\, \\, \\, and t\n"
"```"
msgstr ""

#: src/reference/syntax/r-strings.md:11
msgid ""
"An r-string is closed by the same quote character that opened it, so the "
"other quote character is ordinary content:"
msgstr ""

#: src/reference/syntax/r-strings.md:14
msgid ""
"```prql\n"
"from artists\n"
"derive quoted = r\"it's\"\n"
"```"
msgstr ""
