#: src/reference/stdlib/date.md:87
msgid "**DATE SPECIFIERS:**"
msgstr ""

#: src/reference/stdlib/date.md:88
msgid "`%Y`"
msgstr ""

#: src/reference/stdlib/date.md:88
msgid "`2001`"
msgstr ""

#: src/reference/stdlib/date.md:88
msgid "Year number, zero-padded to 4 digits"
msgstr ""

#: src/reference/stdlib/date.md:89
msgid "`%y`"
msgstr ""

#: src/reference/stdlib/date.md:89
msgid "`01`"
msgstr ""

#: src/reference/stdlib/date.md:89
msgid "Year number, zero-padded to 2 digits"
msgstr ""

#: src/reference/stdlib/date.md:90
msgid "`%m`"
msgstr ""

#: src/reference/stdlib/date.md:90
msgid "`07`"
msgstr ""

#: src/reference/stdlib/date.md:90
msgid "Month number (01–12), zero-padded to 2 digits"
msgstr ""

#: src/reference/stdlib/date.md:91
msgid "`%-m`"
msgstr ""

#: src/reference/stdlib/date.md:91
msgid "`7`"
msgstr ""

#: src/reference/stdlib/date.md:91
msgid "Month number (1-12)"
msgstr ""

#: src/reference/stdlib/date.md:92
msgid "`%b`"
msgstr ""

#: src/reference/stdlib/date.md:92
msgid "`Jul`"
msgstr ""

#: src/reference/stdlib/date.md:92
msgid "Abbreviated month name. Always 3 letters."
msgstr ""

#: src/reference/stdlib/date.md:93
msgid "`%B`"
msgstr ""

#: src/reference/stdlib/date.md:93
msgid "`July`"
msgstr ""

#: src/reference/stdlib/date.md:93
msgid "Full month name"
msgstr ""

#: src/reference/stdlib/date.md:94
msgid "`%d`"
msgstr ""

#: src/reference/stdlib/date.md:94
msgid "`08`"
msgstr ""

#: src/reference/stdlib/date.md:94
msgid "Day number (01-31), zero-padded to 2 digits"
msgstr ""

#: src/reference/stdlib/date.md:95
msgid "`%-d`"
msgstr ""

#: src/reference/stdlib/date.md:95
msgid "` 8`"
msgstr ""

#: src/reference/stdlib/date.md:95
msgid "Day number (1-31)"
msgstr ""

#: src/reference/stdlib/date.md:96
msgid "`%a`"
msgstr ""

#: src/reference/stdlib/date.md:96
msgid "`Sun`"
msgstr ""

#: src/reference/stdlib/date.md:96
msgid "Abbreviated weekday name. Always 3 letters"
msgstr ""

#: src/reference/stdlib/date.md:97
msgid "`%A`"
msgstr ""

#: src/reference/stdlib/date.md:97
msgid "`Sunday`"
msgstr ""

#: src/reference/stdlib/date.md:97
msgid "Full weekday name"
msgstr ""

#: src/reference/stdlib/date.md:98
msgid "`%D`"
msgstr ""

#: src/reference/stdlib/date.md:98 src/reference/stdlib/date.md:99
msgid "`07/08/01`"
msgstr ""

#: src/reference/stdlib/date.md:98
msgid "Month-day-year format. Same as `%m/%d/%y`"
msgstr ""

#: src/reference/stdlib/date.md:99
msgid "`%x`"
msgstr ""

#: src/reference/stdlib/date.md:99
msgid "Locale's date representation"
msgstr ""

#: src/reference/stdlib/date.md:100
msgid "`%F`"
msgstr ""

#: src/reference/stdlib/date.md:100
msgid "`2001-07-08`"
msgstr ""

#: src/reference/stdlib/date.md:100
msgid "Year-month-day format (ISO 8601). Same as `%Y-%m-%d`"
msgstr ""

#: src/reference/stdlib/date.md:102
msgid "**TIME SPECIFIERS:**"
msgstr ""

#: src/reference/stdlib/date.md:103
msgid "`%H`"
msgstr ""

#: src/reference/stdlib/date.md:103
msgid "`00`"
msgstr ""

#: src/reference/stdlib/date.md:103
msgid "Hour number (00-23)"
msgstr ""

#: src/reference/stdlib/date.md:104
msgid "`%k`"
msgstr ""

#: src/reference/stdlib/date.md:104
msgid "` 0`"
msgstr ""

#: src/reference/stdlib/date.md:104
msgid "Same as `%H` but space-padded. Same as `%_H`."
msgstr ""

#: src/reference/stdlib/date.md:105
msgid "`%I`"
msgstr ""

#: src/reference/stdlib/date.md:105
msgid "`12`"
msgstr ""

#: src/reference/stdlib/date.md:105
msgid "Hour number in 12-hour clocks (01--12), zero-padded to 2 digits."
msgstr ""

#: src/reference/stdlib/date.md:106
msgid "`%p`"
msgstr ""

#: src/reference/stdlib/date.md:106
msgid "`AM`"
msgstr ""

#: src/reference/stdlib/date.md:106
msgid "`AM` or `PM` in 12-hour clocks."
msgstr ""

#: src/reference/stdlib/date.md:107
msgid "`%M`"
msgstr ""

#: src/reference/stdlib/date.md:107
msgid "`34`"
msgstr ""

#: src/reference/stdlib/date.md:107
msgid "Minute number (00-59), zero-padded to 2 digits."
msgstr ""

#: src/reference/stdlib/date.md:108
msgid "`%S`"
msgstr ""

#: src/reference/stdlib/date.md:108
msgid "`60`"
msgstr ""

#: src/reference/stdlib/date.md:108
msgid "Second number (00-60), zero-padded to 2 digits."
msgstr ""

#: src/reference/stdlib/date.md:109
msgid "`%f`"
msgstr ""

#: src/reference/stdlib/date.md:109
msgid "`264900`"
msgstr ""

#: src/reference/stdlib/date.md:109
msgid "Number of microseconds[^1] since last whole second"
msgstr ""

#: src/reference/stdlib/date.md:110
msgid "`%R`"
msgstr ""

#: src/reference/stdlib/date.md:110
msgid "`00:34`"
msgstr ""

#: src/reference/stdlib/date.md:110
msgid "Hour-minute format. Same as `%H:%M`."
msgstr ""

#: src/reference/stdlib/date.md:111
msgid "`%T`"
msgstr ""

#: src/reference/stdlib/date.md:111 src/reference/stdlib/date.md:112
msgid "`00:34:60`"
msgstr ""

#: src/reference/stdlib/date.md:111
msgid "Hour-minute-second format. Same as `%H:%M:%S`."
msgstr ""

#: src/reference/stdlib/date.md:112
msgid "`%X`"
msgstr ""

#: src/reference/stdlib/date.md:112
msgid "Locale's time representation (e.g., 23:13:48)."
msgstr ""

#: src/reference/stdlib/date.md:113
msgid "`%r`"
msgstr ""

#: src/reference/stdlib/date.md:113
msgid "`12:34:60 AM`"
msgstr ""

#: src/reference/stdlib/date.md:113
msgid "Locale's 12 hour clock time. (e.g., 11:11:04 PM)"
msgstr ""

